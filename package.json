{
  "name": "dsh-shanhai-kanban",
  "version": "0.1.0",
  "private": true,
  "description": "任务看板：预建任务、定时执行、指定工作区与上游依赖，支持中断继续、自动补跑与状态跟踪。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "test": "node tests/smoke-host.mjs && node tests/smoke-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "shanhai",
    "kanban",
    "task",
    "schedule"
  ],
  "author": {
    "name": "山海紫穹",
    "url": "https://github.com/cn-zhangpeng"
  },
  "license": "MIT"
}
